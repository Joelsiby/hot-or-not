# Site URL (used for Polar checkout redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Postgres) — Project Settings > API. Run supabase/schema.sql once
# (SQL Editor — DDL can't run through these API keys), and create a public
# Storage bucket named "comment-images" for full-size uploads (thumbnails
# are stored inline on the comments row instead).
#
# Works with either key naming Supabase gives you:
#   classic:  SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
#   newer:    NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SECRET_KEY
# Use the project's base URL only (no /rest/v1/ suffix) — the client appends
# that itself.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis — caches each movie's comment thread so it doesn't hit
# Postgres on every request. Create a database at https://console.upstash.com
# and copy the REST credentials (Vercel's Upstash integration sets these for you).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Polar (https://polar.sh) — handles checkout for upvotes. Create an
# organization + a fixed-price ₹100 (INR) product, then an Organization
# Access Token and a webhook pointed at /api/webhooks/polar.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID=
# "sandbox" (default) or "production"
POLAR_SERVER=sandbox

# Razorpay (https://razorpay.com) — not wired into the app yet (posting
# and upvoting still just write the chosen amount directly, see the NOTE
# comments in app/api/comments/route.ts and app/api/upvote/route.ts).
# These are here ready for when that gets built: an individual/freelancer
# account works, just complete KYC (PAN + bank account) in the dashboard.
# Get the keys from Settings > API Keys (separate Test/Live key pairs);
# get the webhook secret from Settings > Webhooks after adding an endpoint
# at /api/webhooks/razorpay subscribed to payment.captured/payment.failed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Same value as RAZORPAY_KEY_ID — NEXT_PUBLIC_ so Razorpay Checkout.js can
# read it in the browser. Never put the secret in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Umami analytics (https://umami.is)
# Leave unset to disable analytics entirely.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Only needed for a self-hosted Umami instance; defaults to Umami Cloud.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
