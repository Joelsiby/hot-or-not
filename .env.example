# Site URL (used for Polar checkout redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Postgres) — Project Settings > API. Run supabase/schema.sql once
# (SQL Editor — DDL can't run through these API keys), and create a public
# Storage bucket named "comment-images" for full-size uploads (thumbnails
# are stored inline on the comments row instead).
#
# Works with either key naming Supabase gives you:
#   classic:  SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
#   newer:    NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SECRET_KEY
# Use the project's base URL only (no /rest/v1/ suffix) — the client appends
# that itself.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anon/publishable key — safe for the browser. Powers the live
# controversies feed's Realtime subscription (Project Settings > API >
# "anon public" key, classic; or "sb_publishable_..." newer key format).
# The URL must ALSO be set as NEXT_PUBLIC_SUPABASE_URL (even if you're
# using the classic SUPABASE_URL above for the server) since only
# NEXT_PUBLIC_-prefixed vars reach the browser bundle. Leave both unset to
# fall back to 30s polling instead of Realtime.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Upstash Redis — caches each movie's comment thread so it doesn't hit
# Postgres on every request. Create a database at https://console.upstash.com
# and copy the REST credentials (Vercel's Upstash integration sets these for you).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Polar (https://polar.sh) — handles checkout for upvotes. Create an
# organization + a fixed-price ₹100 (INR) product, then an Organization
# Access Token and a webhook pointed at /api/webhooks/polar.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID=
# "sandbox" (default) or "production"
POLAR_SERVER=sandbox

# Live controversy bot (lib/controversy-bot) — scrapes Reddit + entertainment
# RSS feeds for movie backlash/controversy signals, stores them in Supabase,
# and auto-adds strong hits as debatable movies. Triggered every 5 min by
# .github/workflows/fetch-controversies.yml, which needs two *repo* secrets
# (Settings > Secrets and variables > Actions), separate from these env vars:
#   CONTROVERSY_CRON_URL = https://<your-domain>/api/cron/fetch-controversies
#   CRON_SECRET           = same value as below
# Leave CRON_SECRET unset locally; set it in production so the endpoint
# can't be triggered by anyone who finds the URL.
CRON_SECRET=
# Optional — Reddit rate-limits generic user agents; a descriptive one helps.
REDDIT_USER_AGENT=hot-or-not-controversy-bot/1.0 (by u/yourname)

# Umami analytics (https://umami.is)
# Leave unset to disable analytics entirely.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Only needed for a self-hosted Umami instance; defaults to Umami Cloud.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
